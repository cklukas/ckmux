//
// Generated by CMake from src/common/version.hpp.in — edit that template,
// never the generated copy. project(ckmux VERSION ...) in CMakeLists.txt is
// the ONE place the version is stated; everything user-visible derives from
// this header: the --version answer and the handshake identity (proto.hpp's
// kBuildIdentity), and the About box / TERM_PROGRAM_VERSION (client_app.cpp).
// Before this header, the version lived in three places and the packaged
// 0.1.0 binary answered `--version` with 0.0.1 — measured, not hypothesized.
//
// The macro exists so adjacent string literals can compose at compile time
// ("ckmux " CKMUX_VERSION_STRING); the string_view is for everyone else.
#pragma once

#include <string_view>

#define CKMUX_VERSION_STRING "@PROJECT_VERSION@"

namespace ckm {
inline constexpr std::string_view kVersionString = CKMUX_VERSION_STRING;
}
